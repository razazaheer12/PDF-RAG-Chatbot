# Backend environment variables — copy to .env and fill in your keys
PORT=5000

# OpenRouter API key (https://openrouter.ai/keys) — used for all LLM calls
GEMINI_API_KEY=sk-or-your-openrouter-api-key

# Pinecone (https://app.pinecone.io)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=pdf-rag-index-v2
PINECONE_DIMENSION=1024

NODE_ENV=development
